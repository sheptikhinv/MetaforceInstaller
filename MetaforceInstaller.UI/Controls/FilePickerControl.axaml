<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="MetaforceInstaller.UI.Controls.FilePickerControl"
             x:Name="Root">
    <DockPanel VerticalAlignment="Center" HorizontalSpacing="8">
        <Label Content="{Binding Title, ElementName=Root}"
               IsVisible="{Binding ShowTitle, ElementName=Root}"
               VerticalContentAlignment="Center"/>
        <Button DockPanel.Dock="Right"
                Content="..."
                IsEnabled="{Binding !IsPickingDisabled, ElementName=Root}"
                Click="OnBrowseClick" />
        <TextBox Text="{Binding Path, ElementName=Root}"
                 IsReadOnly="True"
                 Watermark="Not selected"/>
    </DockPanel>
</UserControl>